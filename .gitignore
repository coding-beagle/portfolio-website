app/node_modules
*.env
*.venv/

# Uploadthat: the live config holds the operator key hash, and the data
# directory holds sessions and uploaded blobs. Neither belongs in a public
# repository — note that anything committed once stays in the history.
uploadthat_config.php
php/uploadthat/config.php
php/uploadthat_data/

# Registry: the live config holds the admin password hash, and the data
# directory holds tokens and every uploaded artifact. Neither belongs in a
# public repository — note that anything committed once stays in the history.
registry_config.php
php/registry/config.php
php/registry_data/

# The nt CLI, installed editable.
cli/*.egg-info/
cli/build/
__pycache__/
*.pyc

# NPaint: cargo's build directory. npaint/build (the deployable page) IS
# committed, like the other build folders — it is what cPanel pulls.
npaint/target/
# Ignore PSD test cases, keep them locally
*psd

# NPaint's sample Photoshop files. Real .psd files are tens of megabytes and
# would sit in the history for good. The `.psd` reader's own tests build the
# files they need, and `files_photoshop_actually_wrote` in src/psd.rs reads
# whatever is in here if it is there and says nothing if it is not — so a
# clean checkout is green and a machine with samples gets the extra cover.
npaint/test_psds/

# NPaint's Select Subject model and its ONNX Runtime: ~230 MB of binaries that
# would sit in the history for good. `make fetch_npaint_model` pulls them, and
# `make deploy_npaint` does that first, so the deploy has them without the
# repository carrying them. The page works without them — Select Subject falls
# back to the built-in search.
npaint/build/models/
npaint/build/vendor/
