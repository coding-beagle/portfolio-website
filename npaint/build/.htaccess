# Deployed to the subdomain document root (npaint.nteague.com).
Options -Indexes

# `WebAssembly.instantiateStreaming` refuses a module served as anything but
# application/wasm. wasm-bindgen falls back to a slower path when that
# happens, so this is a speed-up rather than a requirement.
AddType application/wasm .wasm
AddType image/svg+xml .svg
# ES modules and the model the optional Select Subject downloads.
AddType text/javascript .mjs
AddType application/octet-stream .onnx

<IfModule mod_deflate.c>
  # The ONNX Runtime wasm is 11 MB and the model 4.6 MB; both compress to
  # about a quarter of that, and they are only ever fetched once.
  AddOutputFilterByType DEFLATE application/wasm application/octet-stream text/javascript
</IfModule>

<IfModule mod_headers.c>
  <FilesMatch "\.(wasm|js|mjs|css)$">
    Header set Cache-Control "public, max-age=3600"
  </FilesMatch>
  # The model never changes without changing its name.
  <FilesMatch "\.onnx$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
</IfModule>
