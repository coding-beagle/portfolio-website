{
  "name": "app",
  "version": "0.1.0",
  "private": true,
  "dependencies": {
    "@fortawesome/fontawesome-svg-core": "^6.7.2",
    "@fortawesome/free-brands-svg-icons": "^6.7.2",
    "@fortawesome/free-solid-svg-icons": "^6.7.2",
    "@fortawesome/react-fontawesome": "^0.2.2",
    "@testing-library/dom": "^10.4.0",
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.2.0",
    "@testing-library/user-event": "^13.5.0",
    "fontawesome": "^5.6.3",
    "qrcode-generator": "^2.0.4",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-markdown": "^10.1.0",
    "react-router-dom": "^7.3.0",
    "react-scripts": "^5.0.1",
    "remark-gfm": "^4.0.1",
    "three": "^0.179.1",
    "three.js": "^0.77.0",
    "web-vitals": "^2.1.4"
  },
  "scripts": {
    "posts": "node scripts/build-posts.js",
    "prestart": "npm run posts",
    "start": "react-scripts start",
    "start:hextool": "REACT_APP_TARGET=hextool react-scripts start",
    "start:uploadthat": "REACT_APP_TARGET=uploadthat react-scripts start",
    "prebuild": "npm run posts",
    "build": "react-scripts build",
    "build:hextool": "REACT_APP_TARGET=hextool BUILD_PATH=build-hextool GENERATE_SOURCEMAP=false react-scripts build",
    "postbuild:hextool": "node scripts/finish-hextool-build.js",
    "build:uploadthat": "REACT_APP_TARGET=uploadthat BUILD_PATH=build-uploadthat GENERATE_SOURCEMAP=false react-scripts build",
    "postbuild:uploadthat": "node scripts/finish-uploadthat-build.js",
    "test": "jest --config jest.config.js",
    "eject": "react-scripts eject",
    "test:watch": "jest --config jest.config.js --watch"
  },
  "eslintConfig": {
    "extends": [
      "react-app",
      "react-app/jest"
    ],
    "env": {
      "es2020": true
    }
  },
  "browserslist": {
    "production": [
      ">0.2%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 1 chrome version",
      "last 1 firefox version",
      "last 1 safari version"
    ]
  },
  "proxy": "http://localhost:8787"
}
